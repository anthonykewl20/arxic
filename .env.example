# Arxic runtime configuration stub. The real config schema is frozen in issues #2/#5.
# Copy to .env (never commit .env). All values optional during M0 contracts work.

# Target under test (ADR §16.2 attestation required for non-local classes)
ARXIC_TARGET_ORIGIN=
ARXIC_ENVIRONMENT_CLASS=local-test

# Captured-mail sink + OTP (charter §6; real containers, not mocked)
ARXIC_MAILPIT_SMTP=
ARXIC_MAILPIT_API=

# Model endpoint (hypothesis generation only; never assigns 'verified')
ARXIC_MODEL_PROVIDER=
ARXIC_MODEL_BASE_URL=
ARXIC_MODEL_API_KEY=
ARXIC_MODEL_TIMEOUT_MS=

# Host-bound model binding (#host-bound-model): set ARXIC_MODEL_PROVIDER=host-cli
# to bind the model layer to a locally installed agent CLI (Claude Code, Codex
# CLI, opencode, or any executable that reads a prompt on stdin and writes a
# completion on stdout) INSTEAD of ARXIC_MODEL_BASE_URL/ARXIC_MODEL_API_KEY,
# which are then not required. ARXIC_MODEL_HOST_CLI names the executable;
# ARXIC_MODEL_HOST_CLI_ARGS is optional extra argv, either whitespace-separated
# (no quoting support) or a JSON array of strings (e.g. '["exec","--full-auto"]').
# Token usage is not reported by a CLI: host-bound runs always record zero
# tokens and are marked `provider: "host-bound"` on the run record so they are
# never mistaken for a metered API call that happened to cost nothing.
ARXIC_MODEL_HOST_CLI=
ARXIC_MODEL_HOST_CLI_ARGS=

# Credential vault (dashboard → Administration → Sign-in credentials). Sign-in
# identities entered in the dashboard are stored encrypted with AES-256-GCM
# under a key derived from this value. Leave it unset and the server keeps a
# generated key in a 0600 file beside its database instead — still encrypted at
# rest, but the key travels with the data it protects, so set this to hold the
# key yourself. Changing it makes existing stored credentials unreadable; they
# report as missing and must be entered again.
ARXIC_VAULT_KEY=

# Sign-in identities a visual run uses to reach authorized pages. A project
# names the references it signs in with; give them values here, or in the
# dashboard. An environment value set here takes precedence over the vault.
# ARXIC_SECRET_EXAMPLE_EMAIL=
# ARXIC_SECRET_EXAMPLE_PASSWORD=

# Approved visual baselines are stored under the digest of their own bytes, by
# default beside the workbench database. Point this at durable or
# version-controlled storage (an LFS-tracked path, a mounted bucket) to keep
# baselines independent of this server's state directory. Content-addressed, so
# moving the store is a copy and nothing needs re-approving.
ARXIC_BASELINE_STORE=
