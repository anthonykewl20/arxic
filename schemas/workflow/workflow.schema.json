{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arxic.dev/schemas/workflow/v1.json",
  "title": "Workflow",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "version",
    "title",
    "domain",
    "persona",
    "status",
    "confidence",
    "scope",
    "preconditions",
    "states",
    "transitions",
    "negativeCases",
    "verification",
    "evidenceRefs"
  ],
  "properties": {
    "$schema": { "const": "https://arxic.dev/schemas/workflow/v1.json" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "domain": { "type": "string" },
    "persona": { "type": "string" },
    "status": {
      "enum": ["hypothesized", "observed", "verified", "contradicted", "blocked"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "scope": {
      "type": "object",
      "required": ["commit", "environment", "browser"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "environment": { "type": "string" },
        "browser": { "type": "string" },
        "featureFlags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fixture"],
        "properties": {
          "fixture": { "type": "string" },
          "parameters": {
            "type": "object",
            "patternProperties": { "^.*$": {} },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "action", "assertions", "evidenceRefs"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "action": {
            "type": "object",
            "required": ["intent"],
            "properties": {
              "intent": { "type": "string" },
              "inputRefs": {
                "type": "object",
                "patternProperties": { "^.*$": { "type": "string" } },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["intent"],
              "properties": { "intent": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(src|run|doc):[A-Za-z0-9._#-]+(?::[A-Za-z0-9._#-]+)?$"
            }
          },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "negativeCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expected"],
        "properties": {
          "id": { "type": "string" },
          "expected": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["requiredRuns", "screenshotCheckpoints", "forbidNetworkErrors"],
      "properties": {
        "requiredRuns": { "type": "integer", "minimum": 1 },
        "screenshotCheckpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "forbidNetworkErrors": { "type": "boolean" },
        "trace": { "enum": ["retain", "discard"] }
      },
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(src|run|doc):[A-Za-z0-9._#-]+(?::[A-Za-z0-9._#-]+)?$"
      }
    }
  },
  "additionalProperties": false
}
