{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arxic.dev/schemas/manifest/v1.json",
  "title": "BundleManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "bundleVersion",
    "workflow",
    "repository",
    "commit",
    "appBuildDigest",
    "environment",
    "generator",
    "verification",
    "fileHashes",
    "gateResults",
    "coverage",
    "runId"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "bundleVersion": { "type": "integer", "minimum": 1 },
    "workflow": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["hypothesized", "observed", "verified", "contradicted", "blocked"]
        }
      },
      "additionalProperties": false
    },
    "repository": { "type": "string", "format": "uri" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "appBuildDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": {
      "type": "object",
      "required": ["class"],
      "properties": {
        "class": { "type": "string" },
        "featureFlags": { "type": "array", "items": { "type": "string" } },
        "persona": { "type": "string" },
        "browser": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "kind": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "object",
      "required": ["requiredRuns", "runs"],
      "properties": {
        "requiredRuns": { "type": "integer", "minimum": 1 },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["startedAt", "finishedAt", "passed"],
            "properties": {
              "startedAt": { "type": "string", "format": "date-time" },
              "finishedAt": { "type": "string", "format": "date-time" },
              "passed": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fileHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "gateResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "passed"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "subject", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^ARXIC-[A-Z0-9][A-Z0-9-]*$" },
          "severity": {
            "enum": ["hypothesized", "observed", "contradicted", "blocked"]
          },
          "subject": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "supportedFixes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["denominator"],
      "properties": {
        "denominator": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "contradicted": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "uncovered": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "parentDomainPack": { "type": "string" },
    "runId": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
